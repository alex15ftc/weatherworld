--!strict
-- engine-sim impulse response library (es/sound-library/impulse_responses.mr).
-- Data modules are generated by Tools/convert_impulse_responses.py.
--
-- ImpulseResponses.Load(name) -> ({ int16 samples }, volume)

export type ImpulseResponseData = {
    Name: string,
    Source: string,
    Volume: number,
    SampleRate: number,
    SampleCount: number,
    Data: string,
}

local ImpulseResponses = {}

local DataFolder = script:WaitForChild("Data")
local cache: { [string]: { number } } = {}

local B64 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local decodeMap: { [number]: number } = {}
for i = 1, #B64 do
    decodeMap[string.byte(B64, i)] = i - 1
end

local function base64Decode(s: string): buffer
    local len = #s
    local padding = 0
    if string.sub(s, -2) == "==" then
        padding = 2
    elseif string.sub(s, -1) == "=" then
        padding = 1
    end
    local outLen = (len // 4) * 3 - padding
    local out = buffer.create(outLen)
    local o = 0
    for i = 1, len, 4 do
        local a = decodeMap[string.byte(s, i)] or 0
        local b = decodeMap[string.byte(s, i + 1)] or 0
        local c = decodeMap[string.byte(s, i + 2)] or 0
        local d = decodeMap[string.byte(s, i + 3)] or 0
        local n = a * 262144 + b * 4096 + c * 64 + d
        if o < outLen then buffer.writeu8(out, o, n // 65536); o += 1 end
        if o < outLen then buffer.writeu8(out, o, (n // 256) % 256); o += 1 end
        if o < outLen then buffer.writeu8(out, o, n % 256); o += 1 end
    end
    return out
end

function ImpulseResponses.List(): { string }
    local names = {}
    for _, child in DataFolder:GetChildren() do
        if child:IsA("ModuleScript") then
            table.insert(names, child.Name)
        end
    end
    table.sort(names)
    return names
end

function ImpulseResponses.Load(name: string): ({ number }, number)
    local module = DataFolder:FindFirstChild(name)
    assert(module and module:IsA("ModuleScript"), `Unknown impulse response '{name}'`)
    local data = (require :: any)(module) :: ImpulseResponseData

    local cached = cache[name]
    if cached then
        return cached, data.Volume
    end

    local raw = base64Decode(data.Data)
    local count = buffer.len(raw) // 2
    local samples: { number } = table.create(count, 0)
    for i = 0, count - 1 do
        samples[i + 1] = buffer.readi16(raw, i * 2)
    end
    cache[name] = samples

    return samples, data.Volume
end

return ImpulseResponses
