{
  "name": "CloudLab",
  "emitLegacyScripts": false,
  "tree": {
    "$className": "DataModel",
    "ReplicatedFirst": {
      "$className": "ReplicatedFirst",
      "Bootstrapper": {
        "$path": "Client/Bootstrapper"
      },
      "Modules": {
        "$path": "Client/Modules"
      },
      "Lab": {
        "$path": "Labs/CloudLab/Client"
      }
    },
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Assets": {
        "$className": "Folder",
        "$ignoreUnknownInstances": true
      },
      "Config": {
        "$path": "Config"
      },
      "Packages": {
        "$path": "Packages"
      },
      "Shared": {
        "$path": "Shared"
      }
    },
    "ServerStorage": {
      "$className": "ServerStorage",
      "$ignoreUnknownInstances": true,
      "main": {
        "$path": "Server/main.server.luau"
      },
      "Modules": {
        "$path": "Server/Modules"
      },
      "Lab": {
        "$path": "Labs/CloudLab/Server"
      }
    },
    "Workspace": {
      "$properties": {
        "StreamingEnabled": false
      },
      "Floor": {
        "$className": "Part",
        "$properties": {
          "Anchored": true,
          "Size": [
            2048,
            2,
            2048
          ],
          "Position": [
            0,
            -3,
            3400
          ],
          "Transparency": 1,
          "CanCollide": true
        }
      },
      "Spawn": {
        "$className": "SpawnLocation",
        "$properties": {
          "Anchored": true,
          "Size": [
            12,
            1,
            12
          ],
          "Position": [
            0,
            -1.5,
            3400
          ],
          "Neutral": true
        }
      }
    },
    "HttpService": {
      "$properties": {
        "HttpEnabled": true
      }
    }
  }
}
