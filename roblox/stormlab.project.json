{
  "name": "StormLab",
  "emitLegacyScripts": false,
  "tree": {
    "$className": "DataModel",
    "ReplicatedFirst": {
      "$className": "ReplicatedFirst",
      "Bootstrapper": {
        "$path": "Client/Bootstrapper"
      },
      "Modules": {
        "$path": "Client/Modules"
      },
      "Lab": {
        "$path": "Labs/StormLab/Client"
      }
    },
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Assets": {
        "$className": "Folder",
        "$ignoreUnknownInstances": true
      },
      "Config": {
        "$path": "Config"
      },
      "Packages": {
        "$path": "Packages"
      },
      "Shared": {
        "$path": "Shared"
      }
    },
    "ServerStorage": {
      "$className": "ServerStorage",
      "$ignoreUnknownInstances": true,
      "main": {
        "$path": "Server/main.server.luau"
      },
      "Modules": {
        "$path": "Server/Modules"
      },
      "Lab": {
        "$path": "Labs/StormLab/Server"
      }
    },
    "Workspace": {
      "$properties": {
        "StreamingEnabled": false
      }
    },
    "Lighting": {
      "$properties": {
        "Technology": "Future",
        "GlobalShadows": true
      }
    },
    "MaterialService": {
      "CloudMatte": {
        "$className": "MaterialVariant",
        "$properties": {
          "BaseMaterial": "SmoothPlastic",
          "RoughnessMap": "rbxassetid://95712331838936",
          "StudsPerTile": 64
        }
      }
    }
  }
}
