{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weatherworld.local/schema/calibration-case-v1.json",
  "title": "WeatherWorld calibration case",
  "type": "object",
  "required": ["schemaVersion", "caseId", "split", "classification", "simulation", "targets"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "caseId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$" },
    "description": { "type": "string" },
    "split": { "enum": ["calibration", "validation", "holdout"] },
    "classification": {
      "type": "object",
      "required": ["regime", "severity", "primaryHazard"],
      "properties": {
        "regime": { "type": "string" },
        "severity": { "enum": ["null", "tstm", "marginal", "slight", "enhanced", "moderate", "high"] },
        "primaryHazard": { "enum": ["none", "tornado", "hail", "wind", "mixed"] },
        "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "simulation": {
      "type": "object",
      "required": ["seed", "hours", "members"],
      "properties": {
        "seed": { "type": "integer" },
        "hours": { "type": "number", "minimum": 0.5, "maximum": 72 },
        "members": { "type": "integer", "minimum": 1, "maximum": 500 }
      }
    },
    "targets": {
      "type": "object",
      "required": ["riskRange", "initiationRange", "tornadoRange", "dominantModes"],
      "properties": {
        "riskRange": { "type": "array", "prefixItems": [{"type":"integer"},{"type":"integer"}], "minItems": 2, "maxItems": 2 },
        "initiationRange": { "type": "array", "prefixItems": [{"type":"integer"},{"type":"integer"}], "minItems": 2, "maxItems": 2 },
        "tornadoRange": { "type": "array", "prefixItems": [{"type":"integer"},{"type":"integer"}], "minItems": 2, "maxItems": 2 },
        "dominantModes": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
